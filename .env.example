# PostgreSQL Database
POSTGRES_USER=iqoqo
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=iqoqo

# Database connection URL
# For Docker deployment: Use service name 'db' as host
# For local development: Use 'localhost' with DB_PORT
# Example Docker: postgresql://iqoqo:password@db:5432/iqoqo
# Example Local:  postgresql://iqoqo:password@localhost:5432/iqoqo
LOG_LEVEL=INFO
# Limit words on the generated cover overlay to prevent overlapping/clutter
LLM_TITLE_MAX_WORDS=12
DATABASE_URL="postgresql://iqoqo:changeme_strong_password@db:5432/iqoqo"
# Test database for E2E tests (make test-e2e).
# A dedicated .env.test file (safe to commit) provides this automatically —
# see .env.test for the default local value. Override by setting
# DATABASE_URL_TEST in your shell before running make test-e2e.
DATABASE_URL_TEST="postgresql://iqoqo:changeme_strong_password@localhost:5432/iqoqo_test"

# Port Configuration
# WEB_PORT: External port for accessing the web application (default: 5000)
# DB_PORT: External port for accessing PostgreSQL (default: 5432)
# APP_PORT: External port for nginx reverse proxy in production compose (default: 8000)
# Note: If running multiple services, change these to avoid conflicts (e.g., 8000, 5433)
WEB_PORT=5000
DB_PORT=5432
APP_PORT=8000

# Frontend public API base URL
# For nginx-routed production: /api
# For local frontend dev against Flask directly: http://localhost:5000
NEXT_PUBLIC_API_URL=/api

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
# IMPORTANT: Generate a strong secret key for production!
# You can use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="changeme_generate_strong_key_for_production"

# CORS Configuration (disabled by default)
# Set CORS_ENABLED=true only when your frontend is hosted on a different origin.
# Production example:
# CORS_ENABLED=true
# CORS_ORIGINS="https://app.example.com,https://admin.example.com"
# CORS_SUPPORTS_CREDENTIALS=false
CORS_ENABLED=false
CORS_ORIGINS=""
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_ALLOW_HEADERS="Content-Type,Authorization"
CORS_SUPPORTS_CREDENTIALS=false
FEDERATION_ENABLED=false

ALLOW_LLM=false

# Metadata Fetching Configuration
GOOGLE_BOOKS_API_KEY=""  # Optional: https://console.cloud.google.com/apis/credentials

# Discogs credentials (choose one method):
# 1. Preferred — OAuth v2 Consumer Key & Secret
#    Register an OAuth app at: https://www.discogs.com/settings/developers
DISCOGS_CONSUMER_KEY=""  # Preferred: OAuth v2 consumer key
DISCOGS_CONSUMER_SECRET=""  # Preferred: OAuth v2 consumer secret
# 2. Legacy — Personal Access Token (still works, but DISCOGS_CONSUMER_KEY/SECRET takes precedence)
DISCOGS_USER_TOKEN="" # Legacy: https://www.discogs.com/settings/developers

TMDB_API_KEY="" # Optional (v3 auth): https://www.themoviedb.org/settings/api
TMDB_API_READ_ACCESS_TOKEN="" # Preferred (v4 auth/Bearer token)
BGG_API_TOKEN="" # Register an application at https://boardgamegeek.com/applications to get a token
# IGDB credentials (requires a Twitch developer account)
# Register at: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""
UPC_ITEM_DB_KEY="" # Register at https://www.upcitemdb.com/ (Trial allows limited free lookups)
UPC_DATABASE_ORG_KEY="" # Register at https://upcdatabase.org/ for Tier 1a lookups
ALLEGRO_CLIENT_ID="" # Register at https://apps.developer.allegro.pl/ (Tier 2 retail resolve)
ALLEGRO_CLIENT_SECRET=""

# Covers Generation Configuration
IQOQO_KNOWN_JUNK_PHASHES="e1e1e1e1e1e1e1e1,ffffffff00000000,eea4985b94846fe8"  # Optional: comma-separated pHash hex strings to block known junk covers
# Local Stable Diffusion API URL (if using local SD server instead of OpenAI/Gemini)
LOCAL_SD_URL=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# https://aistudio.google.com/api-keys
GEMINI_API_KEY=""
# Ollama configuration (if using Ollama for local LLM-based cover generation instead of OpenAI/Gemini)
OLLAMA_URL=          # Defaults to "http://localhost:11434"
OLLAMA_VISION_MODEL= # Defaults to "llava"

# Redis / Celery Task Queue
# Required for multi-process Gunicorn scaling.
# For Docker (production/preview):  redis://redis:6379/0  (redis = docker service name)
# For local dev (run_dev.sh):        redis://localhost:6379/0  (Docker port is forwarded)
REDIS_URL=redis://localhost:6379/0


# New Auth variables required by Docker / Application
JWT_SECRET_KEY=your_super_secret_jwt_key
AUTH_SECRET=your_super_secret_auth_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
ADMIN_EMAIL=admin@iqoqo.local
ADMIN_PASSWORD=secure_admin_password
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
DEPLOY_TOKEN=your_deploy_token
RCLONE_REMOTE_FAST=iqoqo-backup
RCLONE_REMOTE_ARCHIVE=iqoqo-glacier

# Background scheduler (cover cleanup watchdog)
SCHEDULER_AUTOSTART=false

# SQL Eviction and connection pooling (PostgreSQL only)
# Default: pool_size=2, max_overflow=3 (10 connections max with web+worker containers)
# SQLALCHEMY_POOL_SIZE=2
# SQLALCHEMY_MAX_OVERFLOW=3

# Background task execution pool
# Supported: prefork, solo, threads, gevent
# Recommendation: use 'threads' for I/O bound metadata retrieval
# CELERY_POOL=threads
# CELERY_CONCURRENCY=4

# ==========================================
# DEFAULT OBSERVABILITY STACK (OpenObserve)
# ==========================================
# OpenObserve is the default unified telemetry backend (traces + metrics + logs).
# It runs as a Docker container alongside the iqoqo stack.
#
# Access: http://localhost:${OPENOBSERVE_HOST_PORT:-5080}
# Login:  ${OPENOBSERVE_ROOT_USER} / ${OPENOBSERVE_ROOT_PASSWORD}
# SQL API: POST http://localhost:${OPENOBSERVE_HOST_PORT:-5080}/api/default/_search
#
# Multi-stack port collision avoidance (prod=5080, preprod=5081):
OPENOBSERVE_HOST_PORT=5080
OPENOBSERVE_ROOT_USER=admin@iqoqo.local
OPENOBSERVE_ROOT_PASSWORD=supersecret

# OTLP Ingestion Ports — exposed on host loopback for AI agent access.
# Override to avoid collision when running multiple iqoqo instances on same host.
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318

# OpenTelemetry exporters (set to 'none' to disable individual pillars)
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Capture Python logging.* calls as OTLP log records (requires OTEL_LOGS_EXPORTER=otlp)
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true

# Browser-side OTel Collector URL (must be CORS-whitelisted in otel-collector-local.yaml)

# OpenObserve Browser RUM and Logs configuration
# http://localhost:5080/web/ingestion/recommended/frontend-monitoring?org_identifier=default
# NOTE: these must be NEXT_PUBLIC_-prefixed to be embedded in the browser bundle
# by Next.js. There is no compiled-in default token: if unset, the frontend
# skips RUM/Logs initialization entirely rather than silently reporting to
# whichever org a hardcoded token happened to belong to.



# --- Internal / Runtime ---
APP_VERSION=          # Set by Docker build arg, auto-detected at runtime
COVERS_ARCHIVE_DIR=   # Archive directory for covers
COVERS_BASE_URL=      # Defaults to /static/covers
FLASK_DEBUG=          # Debug mode, only set in development
IQOQO_SECRET_KEY=     # Derived from SECRET_KEY
IQOQO_WATERMARK_PATH= # Path to watermark overlay image
RATELIMIT_ENABLED=    # Defaults to true
SQLALCHEMY_ECHO=      # Log all SQL queries
ALLEGRO_APP_NAME="iqoqo" # Registered Allegro application name: iqoqo_cc (prod), iqoqo_pre (preview), iqoqo_dev (dev)
