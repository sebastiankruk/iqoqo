# PostgreSQL Database
POSTGRES_USER=iqoqo
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=iqoqo

# Database connection URL
# For Docker deployment: Use service name 'db' as host
# For local development: Use 'localhost' with DB_PORT
# Example Docker: postgresql://iqoqo:password@db:5432/iqoqo
# Example Local:  postgresql://iqoqo:password@localhost:5432/iqoqo
LOG_LEVEL=INFO
# Limit words on the generated cover overlay to prevent overlapping/clutter
LLM_TITLE_MAX_WORDS=12
DATABASE_URL="postgresql://iqoqo:changeme_strong_password@db:5432/iqoqo"
# Test database for E2E tests (make test-e2e).
# A dedicated .env.test file (safe to commit) provides this automatically —
# see .env.test for the default local value. Override by setting
# DATABASE_URL_TEST in your shell before running make test-e2e.
DATABASE_URL_TEST="postgresql://iqoqo:changeme_strong_password@localhost:5432/iqoqo_test"

# E2E_RESET_SECRET: shared secret for the /api/lending/test/reset helper.
# The endpoint resets every lent Item and deletes every loan request, so it is
# gated on three things: not production, TESTING enabled, and this secret
# matching the X-E2E-Reset-Secret header. If it is unset the endpoint refuses
# every request rather than falling open. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
E2E_RESET_SECRET=

# TESTING: enables Flask test mode. Leave UNSET in every deployed environment.
# It disables the APScheduler (app/core/scheduler.py), so setting it in
# production silently stops background jobs. Only 1/true/yes enable it; any
# other value is ignored. The E2E harness sets it for the Flask process it
# spawns (frontend/playwright.config.ts).
TESTING=

# Port Configuration
# WEB_PORT: External port for accessing the web application (default: 5000)
# DB_PORT: External port for accessing PostgreSQL (default: 5432)
# APP_PORT: External port for nginx reverse proxy in production compose (default: 8000)
# Note: If running multiple services, change these to avoid conflicts (e.g., 8000, 5433)
WEB_PORT=5000
DB_PORT=5432
APP_PORT=8000

# Frontend public API base URL
# For nginx-routed production: /api
# For local frontend dev against Flask directly: http://localhost:5000
NEXT_PUBLIC_API_URL=/api

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
# IMPORTANT: Generate a strong secret key for production!
# You can use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="changeme_generate_strong_key_for_production"

# CORS Configuration (disabled by default)
# Set CORS_ENABLED=true only when your frontend is hosted on a different origin.
# Production example:
# CORS_ENABLED=true
# CORS_ORIGINS="https://app.example.com,https://admin.example.com"
# CORS_SUPPORTS_CREDENTIALS=false
CORS_ENABLED=false
CORS_ORIGINS=""
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_ALLOW_HEADERS="Content-Type,Authorization"
CORS_SUPPORTS_CREDENTIALS=false
FEDERATION_ENABLED=false

ALLOW_LLM=false

# Metadata & External API Credentials
# NOTE: External API keys and secrets (such as Google Books, Discogs, TMDB, BGG,
# IGDB/Twitch, UPC databases, Allegro, OpenAI, and Gemini) are no longer managed
# in .env. They are securely managed and encrypted at rest in the database via
# the Admin UI at /admin/settings.

# Covers Generation Configuration
IQOQO_KNOWN_JUNK_PHASHES="e1e1e1e1e1e1e1e1,ffffffff00000000,eea4985b94846fe8"  # Optional: comma-separated pHash hex strings to block known junk covers
# Local Stable Diffusion API URL (if using local SD server instead of OpenAI/Gemini)
LOCAL_SD_URL=
# Ollama configuration (if using Ollama for local LLM-based cover generation instead of OpenAI/Gemini)
OLLAMA_URL=          # Defaults to "http://localhost:11434"
OLLAMA_VISION_MODEL= # Defaults to "llava"
# Wall-clock ceiling for one vision inference call, in seconds. The same model
# needed 45.7s cold and 9.1s warm on a real pairing run, so the previous 30s
# discarded cold starts that would have succeeded. Raise it on a slower host.
OLLAMA_VISION_TIMEOUT=90
OLLAMA_DEDUPE_MODEL= # Local model used for duplicate Work/Manifestation detection; defaults to "llama3:latest"

# Redis / Celery Task Queue
# Required for multi-process Gunicorn scaling.
# For Docker (production/preview):  redis://redis:6379/0  (redis = docker service name)
# For local dev (run_dev.sh):        redis://localhost:6379/0  (Docker port is forwarded)
REDIS_URL=redis://localhost:6379/0


# New Auth variables required by Docker / Application
JWT_SECRET_KEY=your_super_secret_jwt_key
AUTH_SECRET=your_super_secret_auth_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
ADMIN_EMAIL=admin@iqoqo.local
ADMIN_PASSWORD=secure_admin_password
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
# Canonical Linked Open Data base URL for entity IRIs
BASE_URL=https://iqoqo.cc
# Linked Open Data (LOD) entity linking & reconciliation
ENABLE_LOD_LINKING=true
# Precision thresholds for composite entity scoring (range 0.0 to 1.0)
# Candidates with score >= LOD_AUTO_APPLY_THRESHOLD are auto-accepted into catalog filters
LOD_AUTO_APPLY_THRESHOLD=0.82
# Candidates with score between suggestion and auto-apply are saved for human review; below this they are rejected
LOD_SUGGESTION_THRESHOLD=0.55
# Offline GeoNames SQLite gazetteer path (defaults to bundled data/geonames_cities.db with ~25k cities).
# Local database is primary (0ms, 0 network egress).
GEONAMES_DB_PATH=
# Optional remote GeoNames API username. Only used as fallback for obscure places not present in local gazetteer.
GEONAMES_USERNAME=iqoqo_demo
DEPLOY_TOKEN=your_deploy_token

# -- Off-site backup storage --------------------------------------------------
# Two supported backends. cloud_backup.sh picks rclone when a remote is
# available and falls back to S3 otherwise; S3_BACKEND forces the choice.
#
# Which backend the host-side backup scripts use. Leave empty for `auto`, which
# picks rclone whenever a remote or a rclone.conf exists and falls back to S3.
# Values: auto | rclone | s3
S3_BACKEND=
#
# --- Backend 1: rclone (default, host-side backups) ---
# rclone reaches any backend: B2, Google Drive, Dropbox, SFTP, Wasabi, and S3.
# Configure it once with `rclone config`; this only names the remote to use.
RCLONE_REMOTE_FAST=iqoqo-backup
RCLONE_REMOTE_ARCHIVE=iqoqo-glacier:iqoqo-archive
# Path to rclone configuration file (optional; defaults to ~/.config/rclone/rclone.conf).
# Needed if running cron as root while rclone was configured under a regular user:
# RCLONE_CONFIG=/home/username/.config/rclone/rclone.conf

# Note: the CONTAINERS no longer use rclone. app/core/s3_service.py (boto3) is
# what runs inside web/worker, because mounting a plaintext rclone.conf into
# the process that parses untrusted input was the actual risk. Host-side
# scripts still use your rclone install and config exactly as before.
#
# --- Backend 2: S3-compatible (also used in-container) ---
# Used by the in-container backup rotation, cover cache and feedback screenshots
# via app/core/s3_service.py, and available to the host scripts as a fallback.
# Works against AWS S3, MinIO, Cloudflare R2, Wasabi, Backblaze B2 and Oracle
# Cloud Object Storage. Leave every value blank to run fully local: each
# in-app role degrades to a local no-op rather than failing.
#
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=               # only for STS / assumed-role deployments
S3_ENDPOINT_URL=                           # omit for real AWS; e.g. https://minio.example
S3_REGION_NAME=us-east-1
S3_ADDRESSING_STYLE=                       # virtual | path; MinIO and most gateways need `path`
S3_BUCKET_BACKUP=                          # backup archives (retention rotation target)
S3_BUCKET_COVERS=                          # shared cross-instance cover cache
S3_BUCKET_FEEDBACK=                        # feedback screenshot archive
S3_SSE=AES256                              # server-side encryption; `aws:kms` also accepted
S3_SSE_KMS_KEY_ID=                         # required only when S3_SSE=aws:kms
S3_ALLOW_ANONYMOUS=false                   # allow unsigned reads (public buckets only)
S3_KEY_PREFIX=backups/                     # host-side cloud_backup.sh key prefix
# RCLONE_REMOTE_ARCHIVE and RCLONE_FEEDBACK_REMOTE are read only by the
# deprecation warning in app/core/s3_service.py. Leaving either set while its
# S3_BUCKET_* replacement is empty makes the app warn that in-container remote
# storage is disabled, so clear them once you have migrated.
#
# Timeouts are explicit because boto3's defaults can exceed a reverse proxy read
# timeout, which turns a storage outage into an apparent application hang.
S3_CONNECT_TIMEOUT=5
S3_READ_TIMEOUT=30
S3_MAX_POOL_CONNECTIONS=10

# Background scheduler (cover cleanup watchdog)
SCHEDULER_AUTOSTART=false

# SQL Eviction and connection pooling (PostgreSQL only)
# Default: pool_size=2, max_overflow=3 (10 connections max with web+worker containers)
# SQLALCHEMY_POOL_SIZE=2
# SQLALCHEMY_MAX_OVERFLOW=3

# Background task execution pool
# Supported: prefork, solo, threads, gevent
# Recommendation: use 'threads' for I/O bound metadata retrieval
# CELERY_POOL=threads
# CELERY_CONCURRENCY=4

# ==========================================
# DEFAULT OBSERVABILITY STACK (OpenObserve)
# ==========================================
# OpenObserve is the default unified telemetry backend (traces + metrics + logs).
# It runs as a Docker container alongside the iqoqo stack.
#
# Access: http://localhost:${OPENOBSERVE_HOST_PORT:-5080}
# Login:  ${OPENOBSERVE_ROOT_USER} / ${OPENOBSERVE_ROOT_PASSWORD}
# SQL API: POST http://localhost:${OPENOBSERVE_HOST_PORT:-5080}/api/default/_search
#
# Multi-stack port collision avoidance (prod=5080, preprod=5081):
OPENOBSERVE_HOST_PORT=5080
OPENOBSERVE_ROOT_USER=admin@iqoqo.local
OPENOBSERVE_ROOT_PASSWORD=your_secure_openobserve_password
OPENOBSERVE_BASIC_AUTH=  # Base64 of OPENOBSERVE_ROOT_USER:OPENOBSERVE_ROOT_PASSWORD

# OTLP Ingestion Ports — exposed on host loopback for AI agent access.
# Override to avoid collision when running multiple iqoqo instances on same host.
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318

# OpenTelemetry exporters (set to 'none' to disable individual pillars)
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Capture Python logging.* calls as OTLP log records (requires OTEL_LOGS_EXPORTER=otlp)
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true

# Browser-side OTel Collector URL (must be CORS-whitelisted in otel-collector-local.yaml)

# OpenObserve Browser RUM and Logs configuration
# http://localhost:5080/web/ingestion/recommended/frontend-monitoring?org_identifier=default
# NOTE: these must be NEXT_PUBLIC_-prefixed to be embedded in the browser bundle
# by Next.js. There is no compiled-in default token: if unset, the frontend
# skips RUM/Logs initialization entirely rather than silently reporting to
# whichever org a hardcoded token happened to belong to.



# --- OpenObserve RUM provisioning (scripts/provision_rum_token.py) ---
# The RUM client token is provisioned at deploy time; run.sh never writes it to
# a file. Unset leaves browser RUM disabled cleanly. It is a server-side value
# read per request by frontend/app/layout.tsx -- NOT a NEXT_PUBLIC_ build arg,
# because `--prebuilt` deployments pull the frontend image from a registry where
# it was built on CI.
# WARNING: this token is public by construction. It is delivered to the browser
# and grants unauthenticated write access to the RUM stream.
OPENOBSERVE_RUM_CLIENT_TOKEN=
# Validated browser ingest target, host[:port] only. Loopback is accepted on a
# bare `dev` deployment; a non-local deployment requires its own public origin
# over HTTPS. Unset means "use the host of the page the SDK runs on".
OPENOBSERVE_RUM_SITE=
# Transport override. Unset derives insecure/plaintext ingest from the page's
# own protocol, which is correct for a bare-HTTP dev instance and safe under
# HTTPS. Set to false to refuse plaintext even on loopback.
RUM_ALLOW_INSECURE_LOOPBACK=true
# Wall-clock budget for the OpenObserve readiness wait. Attempt-count bounding
# does not bound latency; this does.
RUM_READY_BUDGET_SECONDS=20
# Declare whether a loopback ingest target is acceptable. Unset infers it from
# MODE (true for dev, false for preview/prod). Set explicitly only to override.
RUM_LOCAL_ONLY=
# Image tag reported in the 404 diagnostic. Defaults to the tag pinned in
# docker-compose.monitoring.yml.
OPENOBSERVE_IMAGE_TAG=
# Deployment mode, set by run.sh. Do not set by hand.
MODE=
# Public origin of this deployment. Used as the ingest-site allowlist and to
# derive ZO_CORS_ALLOWED_ORIGINS for browser RUM.
NEXTAUTH_URL=

# --- Internal / Runtime ---
APP_VERSION=          # Set by Docker build arg, auto-detected at runtime
COVERS_ARCHIVE_DIR=   # Archive directory for covers
COVERS_BASE_URL=      # Defaults to /static/covers
FLASK_DEBUG=          # Debug mode, only set in development
IQOQO_SECRET_KEY=     # Derived from SECRET_KEY
IQOQO_WATERMARK_PATH= # Path to watermark overlay image
RATELIMIT_ENABLED=    # Defaults to true
SQLALCHEMY_ECHO=      # Log all SQL queries
ALLEGRO_APP_NAME="iqoqo" # Registered Allegro application name: iqoqo_cc (prod), iqoqo_pre (preview), iqoqo_dev (dev)
# Operational script safeguards (set to 1 to bypass production protection guards)
ALLOW_PROD_RESET=0
ALLOW_PROD_CLEAR=0
ALLOW_PROD_CLONE=0
# Terse output mode for AI agents (suppresses verbose banners/docstrings in pytest, vitest, ruff, pylint, mypy, and make status)
IQOQO_AI_MODE=
ALLOW_LLM=false

# --- Transactional mail (email verification, account-deletion confirmation) ---
# Disabled by default: an instance with no relay must still boot and serve its
# catalogue. See docs/EMAIL_SETUP.md for the full walkthrough.
#
# MAIL_PASSWORD is stored Fernet-encrypted once set from the admin UI, and
# MAIL_FROM_ADDRESS must be an address your relay is willing to send as.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="iQoQo"
# Bounds the relay connection. A black-holed SMTP server must not be able to
# hang a gunicorn worker, which would be a full outage rather than a slow page.
MAIL_TIMEOUT_SECONDS=10
# `smtp` talks to a relay; `memory` records messages instead of sending them.
# The latter is for local development and the e2e stack -- never set it on a
# deployment that expects real mail, because nothing will be sent.
MAIL_TRANSPORT=smtp

# --- Public origin for emailed links ---
# Required for the mail features and deliberately unset by default, so an
# instance that never configures it fails a send loudly instead of mailing a
# localhost link into a real mailbox. Must be https:// in production.
#
# Never derived from the request: a link built from the Host header is
# whatever an attacker chose to send, and for a mailbox-control token that
# means handing it to a domain of their choosing.
PUBLIC_APP_URL=

# --- Isolated SPARQL Execution Service (v0.8.3) ---
# Internal shared secret for signing SPARQL execution requests between web API and runner
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SPARQL_SERVICE_SECRET="changeme_generate_strong_sparql_service_secret"
# Service URL (internal Docker network: http://sparql-runner:5050)
SPARQL_SERVICE_URL="http://sparql-runner:5050"
# Execution mode: service | in_process | auto
SPARQL_EXECUTION_MODE="auto"
# Service enable switch (set to false for controlled 503 canary / rollback)
SPARQL_SERVICE_ENABLED=true
# Execution timeout in seconds for SPARQL queries (default: 15.0)
SPARQL_QUERY_TIMEOUT=15.0
# Listening port for internal SPARQL execution microservice (default: 5050)
SPARQL_SERVICE_PORT=5050
