# .env.dev - Tunnel Specifics
NEXTAUTH_URL=https://dev.your-iqoqo.server
NEXT_PUBLIC_FRONTEND_URL=https://dev.your-iqoqo.server
AUTH_URL=https://dev.your-iqoqo.server/api/auth
AUTH_TRUST_HOST=true

# Tell Flask/CORS to trust the tunnel
CORS_ENABLED=true
CORS_ORIGINS=https://dev.your-iqoqo.server
PREFERRED_URL_SCHEME=https
