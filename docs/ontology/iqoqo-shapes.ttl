# iqoqo SHACL shapes
#
# This file is the canonical home for machine-checkable constraints over the
# iqoqo FRBR ontology (see iqoqo.ttl for the OWL vocabulary).  Constraints
# accumulate here as the ontology grows; each shape mirrors a runtime guard
# in app/core/ontology_validation.py.
@prefix iqoqo: <https://iqoqo.org/ontology#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix frbroo: <http://iflastandards.info/ns/fr/frbr/frbroo/> .
@prefix frbr: <http://iflastandards.info/ns/frbr/frbrer/> .
@prefix schema: <https://schema.org/> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .

iqoqo: a sh:Ontology ;
    rdfs:label "iqoqo SHACL Shapes" ;
    rdfs:comment "SHACL constraints for the iqoqo FRBR ontology." .

# ---------------------------------------------------------------------------
# Work
# Every iqoqo Work is an FRBRoo F1_Work (abstract intellectual creation).
# ---------------------------------------------------------------------------

iqoqo:WorkShape a sh:NodeShape ;
    sh:targetClass iqoqo:Work ;
    sh:name "Work is FRBRoo F1_Work" ;
    sh:description "Every iqoqo Work is an FRBRoo F1_Work." ;
    sh:class frbroo:F1_Work .

# ---------------------------------------------------------------------------
# Work-to-Work expansion links
# A reified iqoqo:WorkExpansionLink must point at two distinct Works and use
# a controlled link type.  Mirrors runtime guard in
# app/core/ontology_validation.py.
# ---------------------------------------------------------------------------

iqoqo:WorkExpansionLinkShape a sh:NodeShape ;
    sh:targetClass iqoqo:WorkExpansionLink ;
    sh:name "Work Expansion Link shape" ;
    sh:description "A WorkExpansionLink reifies iqoqo:is_expansion_of between two distinct F1 Works and must use a controlled link type." ;
    sh:property [
        sh:path iqoqo:baseWork ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:Work ;
        sh:message "A WorkExpansionLink must have exactly one baseWork pointing to a Work." ;
    ] ;
    sh:property [
        sh:path iqoqo:expansionWork ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:Work ;
        sh:message "A WorkExpansionLink must have exactly one expansionWork pointing to a Work." ;
    ] ;
    sh:property [
        sh:path iqoqo:link_type ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "is_expansion_of" ) ;
        sh:message "link_type must be one of the controlled lexicon: is_expansion_of." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "baseWork and expansionWork must be different Works; a Work cannot be its own expansion." ;
        sh:select """
            SELECT $this
            WHERE {
                $this iqoqo:baseWork ?base .
                $this iqoqo:expansionWork ?expansion .
                FILTER(?base = ?expansion)
            }
        """ ;
    ] .

# ---------------------------------------------------------------------------
# F16 Container Aggregation
# An aggregation (box set, board game box) must reference exactly one
# container Work, aggregate only Works as Work components and only Items as
# Item components, and contain at least one aggregate.
# ---------------------------------------------------------------------------

iqoqo:ContainerAggregationShape a sh:NodeShape ;
    sh:targetClass iqoqo:ContainerAggregation ;
    sh:name "F16 Container Aggregation shape" ;
    sh:description "An F16 Container Work aggregation references exactly one container Work and at least one aggregated Work or Item; Works aggregate only Works, Items only Items." ;
    sh:property [
        sh:path iqoqo:containerWork ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:Work ;
        sh:message "A ContainerAggregation must reference exactly one containerWork of type Work." ;
    ] ;
    sh:property [
        sh:path iqoqo:aggregatedWork ;
        sh:class iqoqo:Work ;
        sh:message "aggregatedWork must be of type Work (F1_Work level), never an Expression, Manifestation, or Item." ;
    ] ;
    sh:property [
        sh:path iqoqo:aggregatedItem ;
        sh:class iqoqo:Item ;
        sh:message "aggregatedItem must be of type Item (F5_Item level)." ;
    ] ;
    sh:or (
        [ sh:property [ sh:path iqoqo:aggregatedWork ; sh:minCount 1 ] ]
        [ sh:property [ sh:path iqoqo:aggregatedItem ; sh:minCount 1 ] ]
    ) .

# ---------------------------------------------------------------------------
# Board Game Expansion constraint
# An F1_Work linked as an expansion must not be aggregated into an F16
# Container Work (represented by iqoqo:ContainerAggregation rows).
# Mirrors runtime guard validate_work_not_expansion_aggregated.
# ---------------------------------------------------------------------------

iqoqo:ExpansionWorkShape a sh:NodeShape ;
    sh:targetSubjectsOf iqoqo:is_expansion_of ;
    sh:name "Expansion Work not in Container Work" ;
    sh:description """An F1_Work that is the subject of iqoqo:is_expansion_of
(i.e., the expansion) must not be aggregated as a Work component into an
FRBRoo F16 Container Work.""" ;
    sh:message "Expansion Work must not be aggregated into an F16 Container Work." ;
    sh:property [
        a sh:PropertyShape ;
        sh:path [ sh:inversePath iqoqo:aggregatedWork ] ;
        sh:class iqoqo:ContainerAggregation ;
        sh:maxCount 0 ;
        sh:message "Expansion Work must not be aggregated into an F16 Container Work." ;
    ] .
# ---------------------------------------------------------------------------
# Boardgame Mechanic
# ---------------------------------------------------------------------------

iqoqo:BoardgameMechanicShape a sh:NodeShape ;
    sh:targetClass iqoqo:BoardgameMechanic ;
    sh:name "Boardgame Mechanic shape" ;
    sh:description "A boardgame mechanic is a SKOS Concept." ;
    sh:property [
        sh:path [ sh:inversePath iqoqo:has_mechanic ] ;
        sh:class iqoqo:Work ;
        sh:message "A boardgame mechanic is associated with Works." ;
    ] .

# ---------------------------------------------------------------------------
# Feedback Comment
# ---------------------------------------------------------------------------

iqoqo:FeedbackItemShape a sh:NodeShape ;
    sh:targetClass iqoqo:FeedbackItem ;
    sh:name "Feedback Item shape" ;
    sh:description "A feedback ticket is a SIOC Thread." .

iqoqo:FeedbackCommentShape a sh:NodeShape ;
    sh:targetClass iqoqo:FeedbackComment ;
    sh:name "Feedback Comment shape" ;
    sh:description "A feedback comment is a SIOC Post." .

# ---------------------------------------------------------------------------
# FRBR / Schema.org Shapes (Linked Open Data & Export Validation)
# ---------------------------------------------------------------------------

iqoqo:FRBRExpressionShape a sh:NodeShape ;
    sh:targetClass frbr:Expression ;
    sh:property [
        sh:path frbr:expressionOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Expression must link to exactly one Work via frbr:expressionOf." ;
    ] .

iqoqo:FRBRManifestationShape a sh:NodeShape ;
    sh:targetClass frbr:Manifestation ;
    sh:property [
        sh:path frbr:embodimentOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Manifestation must link to exactly one Expression via frbr:embodimentOf." ;
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Manifestation must have at least one schema:name." ;
    ] ;
    sh:property [
        sh:path schema:isbn ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d{13}$" ;
        sh:message "ISBN must be exactly 13 digits." ;
    ] .

iqoqo:FRBRItemShape a sh:NodeShape ;
    sh:targetClass frbr:Item ;
    sh:property [
        sh:path frbr:exemplarOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Item must link to exactly one Manifestation via frbr:exemplarOf." ;
    ] .

iqoqo:FRBRWorkShape a sh:NodeShape ;
    sh:targetClass frbr:Work ;
    sh:property [
        sh:path frbr:creator ;
        sh:datatype xsd:string ;
        sh:message "Work creator must be a string literal." ;
    ] .

iqoqo:CreativeWorkShape a sh:NodeShape ;
    sh:targetClass schema:CreativeWork ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "CreativeWork must have a schema:name." ;
    ] ;
    sh:property [
        sh:path schema:author ;
        sh:datatype xsd:string ;
        sh:message "schema:author must be a string literal." ;
    ] .

# ---------------------------------------------------------------------------
# Post-v0.7.18 Domain Entity Shapes
# ---------------------------------------------------------------------------

iqoqo:UserWorkIntentShape a sh:NodeShape ;
    sh:targetClass iqoqo:UserWorkIntent ;
    sh:name "User Work Intent shape" ;
    sh:description "A UserWorkIntent links a User to a Work with a progress status." ;
    sh:property [
        sh:path iqoqo:intentWork ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:Work ;
        sh:message "A UserWorkIntent must link to exactly one Work." ;
    ] ;
    sh:property [
        sh:path iqoqo:intentUser ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:User ;
        sh:message "A UserWorkIntent must link to exactly one User." ;
    ] ;
    sh:property [
        sh:path iqoqo:intentStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A UserWorkIntent must have an intent status string." ;
    ] .

iqoqo:ItemCustodyEventShape a sh:NodeShape ;
    sh:targetClass iqoqo:ItemCustodyEvent ;
    sh:name "Item Custody Event shape" ;
    sh:description "An ItemCustodyEvent records an immutable provenance event on an Item." ;
    sh:property [
        sh:path iqoqo:custodyItem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:Item ;
        sh:message "An ItemCustodyEvent must link to exactly one Item." ;
    ] ;
    sh:property [
        sh:path iqoqo:eventType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An ItemCustodyEvent must have an eventType string." ;
    ] ;
    sh:property [
        sh:path iqoqo:recordedAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "An ItemCustodyEvent must have a recordedAt dateTime." ;
    ] .

iqoqo:LoanRequestShape a sh:NodeShape ;
    sh:targetClass iqoqo:LoanRequest ;
    sh:name "Loan Request shape" ;
    sh:description "A circulation LoanRequest links an Item to a requester User." ;
    sh:property [
        sh:path iqoqo:loanItem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:Item ;
        sh:message "A LoanRequest must link to exactly one Item." ;
    ] ;
    sh:property [
        sh:path iqoqo:loanRequester ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:User ;
        sh:message "A LoanRequest must link to exactly one requester User." ;
    ] ;
    sh:property [
        sh:path iqoqo:loanStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A LoanRequest must have a status string." ;
    ] .

iqoqo:ReadingRoadmapShape a sh:NodeShape ;
    sh:targetClass iqoqo:ReadingRoadmap ;
    sh:name "Reading Roadmap shape" ;
    sh:description "A ReadingRoadmap represents a curated path owned by a User." ;
    sh:property [
        sh:path iqoqo:roadmapUser ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:User ;
        sh:message "A ReadingRoadmap must have an author User." ;
    ] ;
    sh:property [
        sh:path iqoqo:roadmapTitle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A ReadingRoadmap must have a title string." ;
    ] .

iqoqo:RoadmapItemShape a sh:NodeShape ;
    sh:targetClass iqoqo:RoadmapItem ;
    sh:name "Roadmap Item shape" ;
    sh:description "A RoadmapItem is an ordered step in a ReadingRoadmap." ;
    sh:property [
        sh:path iqoqo:inRoadmap ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:ReadingRoadmap ;
        sh:message "A RoadmapItem must belong to a ReadingRoadmap." ;
    ] ;
    sh:property [
        sh:path iqoqo:roadmapPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "A RoadmapItem must have an integer position." ;
    ] ;
    sh:or (
        [ sh:property [ sh:path iqoqo:roadmapWork ; sh:minCount 1 ; sh:class iqoqo:Work ] ]
        [ sh:property [ sh:path iqoqo:roadmapManifestation ; sh:minCount 1 ; sh:class iqoqo:Manifestation ] ]
    ) .

iqoqo:TagShape a sh:NodeShape ;
    sh:targetClass iqoqo:Tag ;
    sh:name "Tag shape" ;
    sh:description "A folksonomic or curated Tag." ;
    sh:property [
        sh:path iqoqo:tagName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A Tag must have a tagName string." ;
    ] .

iqoqo:ItemTagShape a sh:NodeShape ;
    sh:targetClass iqoqo:ItemTag ;
    sh:name "Item Tag shape" ;
    sh:description "Reified link between an Item and a Tag." ;
    sh:property [
        sh:path iqoqo:taggedItem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:Item ;
        sh:message "An ItemTag must link to exactly one Item." ;
    ] ;
    sh:property [
        sh:path iqoqo:hasTag ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:Tag ;
        sh:message "An ItemTag must link to exactly one Tag." ;
    ] .

iqoqo:SocialNoteShape a sh:NodeShape ;
    sh:targetClass iqoqo:SocialNote ;
    sh:name "Social Note shape" ;
    sh:description "A SocialNote is attached to exactly one FRBR entity level (Work, Expression, Manifestation, or Item)." ;
    sh:property [
        sh:path iqoqo:noteText ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A SocialNote must have text content." ;
    ] ;
    sh:property [
        sh:path iqoqo:noteUser ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:User ;
        sh:message "A SocialNote must have an author User." ;
    ] ;
    sh:xone (
        [ sh:property [ sh:path iqoqo:noteTargetWork ; sh:minCount 1 ; sh:maxCount 1 ; sh:class iqoqo:Work ] ]
        [ sh:property [ sh:path iqoqo:noteTargetExpression ; sh:minCount 1 ; sh:maxCount 1 ; sh:class iqoqo:Expression ] ]
        [ sh:property [ sh:path iqoqo:noteTargetManifestation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class iqoqo:Manifestation ] ]
        [ sh:property [ sh:path iqoqo:noteTargetItem ; sh:minCount 1 ; sh:maxCount 1 ; sh:class iqoqo:Item ] ]
    ) .

iqoqo:EscalationRequestShape a sh:NodeShape ;
    sh:targetClass iqoqo:EscalationRequest ;
    sh:name "Escalation Request shape" ;
    sh:description "An EscalationRequest reports an issue or correction for administrative action." ;
    sh:property [
        sh:path iqoqo:escalationUser ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class iqoqo:User ;
        sh:message "An EscalationRequest must have an initiator User." ;
    ] ;
    sh:property [
        sh:path iqoqo:fieldName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An EscalationRequest must specify the fieldName." ;
    ] ;
    sh:property [
        sh:path iqoqo:suggestedValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An EscalationRequest must specify the suggestedValue." ;
    ] .

iqoqo:EntityAuditLogShape a sh:NodeShape ;
    sh:targetClass iqoqo:EntityAuditLog ;
    sh:name "Entity Audit Log shape" ;
    sh:description "An EntityAuditLog records changes to catalog entities." ;
    sh:property [
        sh:path iqoqo:auditEntityType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An EntityAuditLog must record auditEntityType." ;
    ] ;
    sh:property [
        sh:path iqoqo:auditEntityId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "An EntityAuditLog must record an integer auditEntityId." ;
    ] ;
    sh:property [
        sh:path iqoqo:auditChangeType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An EntityAuditLog must record auditChangeType." ;
    ] ;
    sh:property [
        sh:path iqoqo:auditLoggedAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "An EntityAuditLog must record auditLoggedAt dateTime." ;
    ] .


