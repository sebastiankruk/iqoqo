{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".github/copilot-instructions.md",
    ".github/context/private-notes/plan/*.md",
    ".github/context/private-notes/code/*.md",
    ".github/context/private-notes/review/*.md",
    ".github/context/private-notes/tests/*.md",
    ".github/context/private-notes/tools/*.md",
    ".github/context/private-notes/gemini/*.md"
  ],
  "agent": {
    "junior-dev": {
      "description": "Junior developer for implementing existing plans",
      "mode": "all",
      "model": "antigravity-claude-sonnet-4-6",
      "prompt": "{file:../.github/agents/junior-dev.agent.md}",
      "tools": {
        "write": true,
        "edit": true,
        "batch": true
      }
    }
  }
}
