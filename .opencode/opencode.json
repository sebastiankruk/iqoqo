  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "../.agents/rules/iqoqo-standards.md"
  ],
  "plugin": [
    "opencode-ignore",
    ".opencode/plugins/graphify.js"
  ],
  "skills": {
