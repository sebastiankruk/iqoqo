# ===========================================================================
# Isolated SPARQL Execution Service Dockerfile
# Least-privileged, non-root, read-only filesystem, no database secrets.
# OpenSpec change `sparql-execution-service-v083`.
# ===========================================================================

# Stage 1: builder
FROM python:3.14-slim AS builder

WORKDIR /usr/src/app

COPY requirements.txt ./
RUN sed -i '/# Testing/,$d' requirements.txt && \
    pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt

# Stage 2: runtime
FROM python:3.14-slim

# Dedicated unprivileged system user
RUN useradd -u 10002 -m -s /bin/sh sparqluser

WORKDIR /usr/src/app

COPY requirements.txt ./
RUN --mount=type=bind,from=builder,source=/wheels,target=/mnt/wheels \
    sed -i '/# Testing/,$d' requirements.txt && \
    pip install --no-cache-dir --no-index --find-links=/mnt/wheels \
        flask gunicorn rdflib pyparsing opentelemetry-api && \
    rm -f requirements.txt && \
    find /usr/local/lib/python3.14 -name '__pycache__' -type d -prune -exec rm -rf {} + && \
    find /usr/local/lib/python3.14 -name '*.pyc' -delete

# Copy only the application code needed by the service
COPY --chown=sparqluser:sparqluser app/services/sparql app/services/sparql/
COPY --chown=sparqluser:sparqluser app/services/__init__.py app/services/__init__.py
RUN touch app/__init__.py

RUN python -m compileall -q app >/dev/null 2>&1 || true

ENV PYTHONDONTWRITEBYTECODE=1
ENV HOME=/home/sparqluser
ENV SPARQL_SERVICE_PORT=5050

USER sparqluser

EXPOSE 5050

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5050/healthz')"

CMD ["gunicorn", "--bind", "0.0.0.0:5050", "--workers", "2", "--threads", "4", "--timeout", "35", "--no-control-socket", "--access-logfile", "-", "--error-logfile", "-", "app.services.sparql.server:create_service_app()"]
