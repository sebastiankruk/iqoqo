# Nginx with native OpenTelemetry C-module for Layer 6 instrumentation.
# Switches from nginx:1.25-alpine (no OTel module) to nginx:1.25 (Debian-based)
# which supports the nginx-module-otel package.
#
# The existing routing logic in deploy/nginx.conf is preserved unchanged —
# this Dockerfile only adds the OTel module and overrides the main nginx.conf
# to load it at startup.

FROM nginx:1.25

# Install the native OpenTelemetry module.
# nginx-module-otel is available in the official Debian nginx package repos.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx-module-otel \
    && rm -rf /var/lib/apt/lists/*

# Override core nginx.conf to load the OTel module and configure telemetry.
# The virtual host routing logic (deploy/nginx.conf) is mounted at runtime via
# docker-compose.yml into /etc/nginx/conf.d/default.conf and included
# automatically by the `include /etc/nginx/conf.d/*.conf` directive below.
COPY deploy/nginx-main.conf /etc/nginx/nginx.conf
