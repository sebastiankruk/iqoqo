{
  // VS Code debug configurations for iqoqo
  // Prerequisites: ensure PostgreSQL is running first (e.g. `docker-compose up -d db`)
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fetch Covers",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.fetch_covers",
      "args": [
        "--limit",
        "${input:coverLimit}"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}"
    },
    {
      // Launch Flask API with full debugpy support.
      // --no-reload is required: the Flask reloader forks a child process and
      // VS Code's debugger attaches to the parent, so breakpoints would be
      // silently skipped in the reloaded worker without this flag.
      "name": "Flask API (debug, no reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": [
        "run",
        "--no-debugger",
        "--no-reload",
        "--port",
        "5001"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "FLASK_APP": "run.py",
        "FLASK_DEBUG": "1"
      },
      "jinja": true,
      "cwd": "${workspaceFolder}",
      // Start DB and apply migrations before launching Flask
      "preLaunchTask": "db: migrate"
    },
    {
      // Attach to a Flask process that was started externally with debugpy listening.
      // Start Flask manually:
      //   .venv/bin/python -m debugpy --listen 5678 --wait-for-client \
      //     -m flask run --no-reload --port 5000
      "name": "Attach to Flask (debugpy port 5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "."
        }
      ]
    },
    {
      // Debug Next.js server-side code: Server Components, Route Handlers, Server Actions.
      // Attaches to the Node.js inspector that `npm run dev:debug` opens on port 9229.
      // Start the frontend first: cd frontend && npm run dev:debug
      "name": "Next.js: attach server (Node)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "cwd": "${workspaceFolder}/frontend",
      // Start Next.js dev:debug before attaching
      "preLaunchTask": "frontend: dev:debug",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/frontend/**",
        "!**/node_modules/**"
      ]
    },
    {
      // Debug Next.js client-side code: Client Components running in the browser.
      // Works with Chrome or Edge. Make sure the browser is open at localhost:3000
      // before attaching — VS Code will reuse the existing tab.
      "name": "Next.js: attach client (Chrome)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "urlFilter": "http://localhost:3000/*",
      "cwd": "${workspaceFolder}/frontend",
      "preLaunchTask": "chrome: wait for debug port",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/frontend/*"
      }
    }
  ],
  "inputs": [
    {
      "id": "coverLimit",
      "type": "promptString",
      "description": "Maximum number of covers to fetch (leave blank for no limit)",
      "default": "10"
    }
  ],
  "compounds": [
    {
      // ── ONE-CLICK FULL DEBUG ──────────────────────────────────────────────
      // Just press F5 with this compound selected. Everything is automatic:
      //   - DB starts → role fixed → migrations run → Flask launches with debugpy
      //   - Next.js starts with --inspect → Node debugger attaches
      //   - Chromium launches with --remote-debugging-port=9222 → Chrome debugger attaches
      // No manual steps required.
      "name": "iqoqo: debug everything",
      "configurations": [
        "Flask API (debug, no reload)",
        "Next.js: attach server (Node)",
        "Next.js: attach client (Chrome)"
      ],
      "stopAll": true
    },
    {
      // Attach to both the Node.js (server) and Chrome (client) debuggers at once.
      // Prerequisites:
      //   1. cd frontend && npm run dev:debug   (starts Next.js with --inspect on :9229)
      //   2. Run task "chrome: open with remote debugging" or:
      //        open -a "Google Chrome" --args --remote-debugging-port=9222
      //      then navigate to http://localhost:3000
      "name": "Next.js: full-stack (server + client)",
      "configurations": [
        "Next.js: attach server (Node)",
        "Next.js: attach client (Chrome)"
      ],
      "stopAll": true
    }
  ]
}
