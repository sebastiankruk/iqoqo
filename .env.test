# Test environment configuration for E2E tests (make test-e2e).
#
# This file is intentionally committed to the repository — it contains
# only non-secret test credentials that are safe to share.
# For local dev the Docker Compose `db` service must be running
# (make start / docker compose up -d db redis).
#
# Override any of these by setting the variable in your shell before running
# make test-e2e, e.g.:
#   DATABASE_URL_TEST=postgresql://myuser:mypass@localhost:5432/iqoqo_test make test-e2e

# Dedicated test database — MUST be separate from your dev/prod DB!
# Password must match POSTGRES_PASSWORD in your .env (which docker-compose uses).
DATABASE_URL_TEST=postgresql://iqoqo_user:ujia9qcf04rivbtqxdls@localhost:5434/iqoqo_test

# Flask test settings
SECRET_KEY=test-secret-key-not-for-production
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@iqoqo.local

# Disable rate-limiting during tests
RATELIMIT_ENABLED=False

# Scheduler should not run during tests
SCHEDULER_AUTOSTART=false
