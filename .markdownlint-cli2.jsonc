{
  "config": ".markdownlint.json",
  "ignores": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/frontend/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/migrations/**",
    "**/*.egg-info/**",
    "**/__pycache__/**",
    "**/.github/**",
    "**/.context/**",
    "**/.git/**",
    ".agent/**",
    ".gemini/skills/**",
    ".opencode/**"
  ],
}
