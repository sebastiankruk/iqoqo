{
  "config": ".markdownlint.json",
  "ignores": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/frontend/node_modules/**",
    "**/frontend/.next/**",
    "**/frontend/playwright-report/**",
    "**/frontend/test-results/**",
    "**/build/**",
    "**/dist/**",
    "**/migrations/**",
    "**/*.egg-info/**",
    "**/__pycache__/**",
    "**/.github/**",
    "**/.context/**",
    "**/.git/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.gemini/**",
    "**/.caim/**",
    "**/.opencode/**",
    "**/.claude/**",
    "**/.pytest_cache/**",
    "**/mykg_sessions/**",
    "**/.mykg_sessions/**",
    "**/.mykg_work/**",
    "**/graphify-out/**",
    "**/openspec/changes/**"
  ]
}
