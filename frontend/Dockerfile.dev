# Development Dockerfile for Next.js frontend
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy application files
COPY . .

# Inject version
ARG APP_VERSION=dev
ENV NEXT_PUBLIC_APP_VERSION=$APP_VERSION

# Expose port 3000
EXPOSE 3000

# Start development server
CMD ["npm", "run", "dev"]
