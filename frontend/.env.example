# iqoqo Frontend Environment Variables
# Copy this file to .env.local and update the values

# API URL for backend communication
# For local development, use: http://localhost:5000
# For Docker development, use: http://web:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# OpenObserve Browser RUM and Logs configuration
# Leave unset unless you have a local OpenObserve. A real token here is
# public by design (it reaches the browser), but a token-shaped placeholder
# in a committed example file reads as a leak.
#
# Prefer the unprefixed OPENOBSERVE_RUM_* names: those are read at request
# time by app/layout.tsx and passed to the SDK as props. The NEXT_PUBLIC_*
# names below are compiled into the client bundle at BUILD time, which does not
# work for a prebuilt image pulled from a registry, and which would bake one
# instance's token into a shared image. They remain as fallbacks for local dev.
#
# SITE, INSECURE_HTTP and PRIVACY_LEVEL are deliberately left empty/defaulted:
#   - SITE unset          -> the host of the page the SDK runs on. Setting
#                            localhost here points every *visitor's* browser at
#                            their own machine.
#   - INSECURE_HTTP unset -> derived from the page's protocol: true on a bare
#                            HTTP dev page, false under HTTPS.
#   - PRIVACY_LEVEL       -> mask-user-input. Session replay records DOM text
#                            and keystrokes unmasked at "allow".
NEXT_PUBLIC_OPENOBSERVE_RUM_CLIENT_TOKEN=
NEXT_PUBLIC_OPENOBSERVE_RUM_APPLICATION_ID=web-application-id
NEXT_PUBLIC_OPENOBSERVE_RUM_SITE=
NEXT_PUBLIC_OPENOBSERVE_RUM_ORG_ID=default
NEXT_PUBLIC_OPENOBSERVE_RUM_SERVICE=iqoqo-frontend
NEXT_PUBLIC_OPENOBSERVE_RUM_ENV=development
NEXT_PUBLIC_OPENOBSERVE_RUM_VERSION=0.0.1
NEXT_PUBLIC_OPENOBSERVE_RUM_INSECURE_HTTP=
NEXT_PUBLIC_OPENOBSERVE_RUM_API_VERSION=v1
NEXT_PUBLIC_OPENOBSERVE_RUM_PRIVACY_LEVEL=mask-user-input

