# .geminiignore

# This file tells the Gemini agent which files to read, even if they are
# in .gitignore. Use ! to negate a pattern from .gitignore.

# 1. Un-ignore the parent directories and exact wildcards from .gitignore
!/.github/
!/.context/
!/.context/*

# 2. Allow the agent to access the primary instructions file.
!/.github/copilot-instructions.md

# 3. Allow the agent to access all nested context files.
!/.context/**
